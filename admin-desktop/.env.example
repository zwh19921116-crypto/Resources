# Copy this to .env and fill in SMTP_PASS with your mailbox password/app password.
# .env itself is gitignored so real credentials never reach GitHub.
SMTP_HOST=ventraip.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=williamc@edgeducate.com.au
SMTP_PASS=
ADMIN_EMAIL_TO=admin@edgeducate.com.au

# Ad impression stats — same value as the Cloudflare Worker's encrypted STATS_SECRET variable.
IMPRESSIONS_STATS_SECRET=
