{
  "name": "edgeducate-admin-desktop",
  "version": "1.0.0",
  "description": "Desktop shell for the Edgeducate Resource Master Control admin panel",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.edgeducate.admin",
    "productName": "Edgeducate Admin",
    "win": {
      "target": "portable"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": []
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "nodemailer": "^9.0.6",
    "qrcode": "^1.5.4"
  }
}
